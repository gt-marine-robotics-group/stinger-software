<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    <bridge>
      <ros_topic_name>/${resolved_topic_prefix}/camera_0/image_raw</ros_topic_name>
      <gz_topic_name>/${resolved_topic_prefix}/camera_0/image_raw</gz_topic_name>
      <ros_type_name>sensor_msgs/msg/Image</ros_type_name>
      <gz_type_name>gz.msgs.Image</gz_type_name>
      <direction>GZ_TO_ROS</direction>
    </bridge>
    <bridge>
      <ros_topic_name>/${resolved_topic_prefix}/laser/scan</ros_topic_name>
      <gz_topic_name>/${resolved_topic_prefix}/laser/scan</gz_topic_name>
      <ros_type_name>sensor_msgs/msg/LaserScan</ros_type_name>
      <gz_type_name>gz.msgs.LaserScan</gz_type_name>
      <direction>GZ_TO_ROS</direction>
    </bridge>
    <bridge>
      <ros_topic_name>/${resolved_topic_prefix}/imu/data</ros_topic_name>
      <gz_topic_name>/${resolved_topic_prefix}/imu/data</gz_topic_name>
      <ros_type_name>sensor_msgs/msg/Imu</ros_type_name>
      <gz_type_name>gz.msgs.IMU</gz_type_name>
      <direction>GZ_TO_ROS</direction>
    </bridge>
    <bridge>
      <ros_topic_name>/${resolved_topic_prefix}/gps/fix</ros_topic_name>
      <gz_topic_name>/${resolved_topic_prefix}/gps/fix</gz_topic_name>
      <ros_type_name>sensor_msgs/msg/NavSatFix</ros_type_name>
      <gz_type_name>gz.msgs.NavSat</gz_type_name>
      <direction>GZ_TO_ROS</direction>
    </bridge>
    <bridge>
      <ros_topic_name>/${resolved_topic_prefix}/thruster_port/cmd_thrust</ros_topic_name>
      <gz_topic_name>/model/${model_name}/joint/${frame_prefix}prop_joint_port/cmd_thrust</gz_topic_name>
      <ros_type_name>std_msgs/msg/Float64</ros_type_name>
      <gz_type_name>gz.msgs.Double</gz_type_name>
      <direction>ROS_TO_GZ</direction>
    </bridge>
    <bridge>
      <ros_topic_name>/${resolved_topic_prefix}/thruster_stbd/cmd_thrust</ros_topic_name>
      <gz_topic_name>/model/${model_name}/joint/${frame_prefix}prop_joint_stbd/cmd_thrust</gz_topic_name>
      <ros_type_name>std_msgs/msg/Float64</ros_type_name>
      <gz_type_name>gz.msgs.Double</gz_type_name>
      <direction>ROS_TO_GZ</direction>
    </bridge>
    <bridge>
      <ros_topic_name>/ground_truth/${model_name}/odometry</ros_topic_name>
      <gz_topic_name>/model/${model_name}/odometry_with_covariance</gz_topic_name>
      <ros_type_name>nav_msgs/msg/Odometry</ros_type_name>
      <gz_type_name>gz.msgs.OdometryWithCovariance</gz_type_name>
      <direction>GZ_TO_ROS</direction>
    </bridge>
  </gazebo>
</robot>
