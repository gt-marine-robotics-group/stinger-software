<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <gazebo>
    <bridge
      ros_topic="/${resolved_topic_prefix}/camera_0/image_raw"
      gz_topic="/${resolved_topic_prefix}/camera_0/image_raw"
      ros_type="sensor_msgs/msg/Image"
      gz_type="gz.msgs.Image"
      direction="gz_to_ros"/>
    <bridge
      ros_topic="/${resolved_topic_prefix}/laser/scan"
      gz_topic="/${resolved_topic_prefix}/laser/scan"
      ros_type="sensor_msgs/msg/LaserScan"
      gz_type="gz.msgs.LaserScan"
      direction="gz_to_ros"/>
    <bridge
      ros_topic="/${resolved_topic_prefix}/imu/data"
      gz_topic="/${resolved_topic_prefix}/imu/data"
      ros_type="sensor_msgs/msg/Imu"
      gz_type="gz.msgs.IMU"
      direction="gz_to_ros"/>
    <bridge
      ros_topic="/${resolved_topic_prefix}/gps/fix"
      gz_topic="/${resolved_topic_prefix}/gps/fix"
      ros_type="sensor_msgs/msg/NavSatFix"
      gz_type="gz.msgs.NavSat"
      direction="gz_to_ros"/>
    <bridge
      ros_topic="/${resolved_topic_prefix}/thruster_port/cmd_thrust"
      gz_topic="/model/${model_name}/joint/${frame_prefix}prop_joint_port/cmd_thrust"
      ros_type="std_msgs/msg/Float64"
      gz_type="gz.msgs.Double"
      direction="ros_to_gz"/>
    <bridge
      ros_topic="/${resolved_topic_prefix}/thruster_stbd/cmd_thrust"
      gz_topic="/model/${model_name}/joint/${frame_prefix}prop_joint_stbd/cmd_thrust"
      ros_type="std_msgs/msg/Float64"
      gz_type="gz.msgs.Double"
      direction="ros_to_gz"/>
    <bridge
      ros_topic="/ground_truth/${model_name}/odometry"
      gz_topic="/model/${model_name}/odometry_with_covariance"
      ros_type="nav_msgs/msg/Odometry"
      gz_type="gz.msgs.OdometryWithCovariance"
      direction="gz_to_ros"/>
  </gazebo>
</robot>
