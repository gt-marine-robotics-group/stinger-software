<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="stinger_tug">
  <xacro:arg name="prefix" default="__default__"/>
  <xacro:arg name="namespace" default="__default__"/>
  <xacro:arg name="topic_prefix" default="__default__"/>
  <xacro:property name="frame_prefix" value="${xacro.arg('prefix') if xacro.arg('prefix') != '__default__' else xacro.arg('namespace') + '_' if xacro.arg('namespace') != '__default__' else ''}"/>
  <xacro:property name="resolved_topic_prefix" value="${xacro.arg('topic_prefix') if xacro.arg('topic_prefix') != '__default__' else xacro.arg('namespace') if xacro.arg('namespace') != '__default__' else 'stinger'}"/>
  <xacro:property name="model_name" value="${xacro.arg('namespace') + '_stinger_tug' if xacro.arg('namespace') != '__default__' else 'stinger'}"/>
  <xacro:include filename="$(find stinger_description)/models/stinger_base/simulation/gz.xacro"/>
  <xacro:include filename="$(find stinger_description)/models/stinger_base/stinger_base.xacro"/>
  <link name="${frame_prefix}base_link">
  </link>
  <xacro:stinger_base
    prefix="${frame_prefix}"
    topic_prefix="${resolved_topic_prefix}"/>
  <joint name="${frame_prefix}hull_joint" type="fixed">
    <origin xyz="0 0 0"/>
    <parent link="${frame_prefix}base_link"/>
    <child link="${frame_prefix}hull_link"/>
  </joint>
</robot>